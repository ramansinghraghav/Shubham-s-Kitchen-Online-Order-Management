# Django Core
DJANGO_SECRET_KEY=your-strong-secret-key-change-this-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Database
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/shubham_kitchen

# Razorpay
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Unsplash (optional)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key

# JWT
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7

# Timezone
DJANGO_TIME_ZONE=Asia/Kolkata

# Session & Cookie Security (production mein True rakhna)
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_SESSION_COOKIE_SAMESITE=Lax
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SAMESITE=Lax

# HTTPS Security
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True
DJANGO_SECURE_REFERRER_POLICY=same-origin

# DB Connection
DB_CONN_MAX_AGE=60
